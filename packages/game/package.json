{
  "name": "@sudoku-killer/game",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@sudoku-killer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@sudoku-killer/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sudoku-killer/engine": "workspace:*",
    "@sudoku-killer/protocol": "workspace:*",
    "@sudoku-killer/scoring": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sudoku-killer/bank": "workspace:*"
  }
}
