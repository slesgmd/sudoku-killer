# Configuración del servidor de salas. Copia este archivo como apps/server/.env (no se versiona) o
# define las variables en el entorno. En desarrollo, `pnpm --filter @sudoku-killer/server db:setup-local`
# crea el rol y la base locales y escribe DATABASE_URL en apps/server/.env sin mostrarla.

# PostgreSQL. Nunca el usuario postgres: un rol propio, dueño solo de su base.
DATABASE_URL=postgres://sudoku_killer:<contraseña>@127.0.0.1:5432/sudoku_killer

# Dirección y puerto del servidor HTTP y WebSocket (/ws).
HOST=127.0.0.1
PORT=8080

# Orígenes de la web desde los que se acepta el WebSocket, separados por comas, sin barra final ni
# ruta, tal como los envía el navegador: un dominio con «ñ» o tildes va en punycode (xn--…). Si no, el
# servidor no arranca. Obligatoria en producción, donde se escribe en el panel del hosting (R-41).
ALLOWED_ORIGINS=http://localhost:5173

# debug, info, warn o error.
LOG_LEVEL=info

# El hash de la clave de acceso del grupo, opcional. Lo da
# `pnpm --filter @sudoku-killer/server access:key` y se escribe solo en el panel del hosting. Sin él,
# no se pide clave. En producción (NODE_ENV=production), eso solo se permite con ACCESS_OPEN=true, para
# que una variable olvidada no abra el servidor. Con las dos variables, gana la clave.
# ACCESS_KEY_HASH=sha256:<64 dígitos hexadecimales>
# ACCESS_OPEN=true

# Proxies de confianza delante del servidor (0 en local; 1 en Render): la IP del cliente sale de
# X-Forwarded-For contando desde la derecha (tope de conexiones y esperas por IP).
# TRUST_PROXY_HOPS=0

# Migraciones destructivas que este despliegue puede aplicar, separadas por comas, por ejemplo
# 0003_drop_x. En producción, una destructiva pendiente que no esté aquí detiene el arranque.
# MIGRATIONS_ALLOW=
