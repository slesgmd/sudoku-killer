{
  "name": "@sudoku-killer/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=@sudoku-killer/source --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "bank:generate": "node --conditions=@sudoku-killer/source scripts/generate-bank.ts",
    "bank:sample": "node --conditions=@sudoku-killer/source scripts/print-sample.ts",
    "db:generate": "drizzle-kit generate",
    "scoring:simulate": "node --conditions=@sudoku-killer/source scripts/simulate-scoring.ts",
    "scoring:calibrate": "node --conditions=@sudoku-killer/source scripts/calibrate-scoring.ts",
    "db:setup-local": "node --conditions=@sudoku-killer/source scripts/setup-local-db.ts",
    "db:check-local": "node --env-file-if-exists=.env scripts/check-local-db.ts",
    "db:migrate": "node --conditions=@sudoku-killer/source --env-file-if-exists=.env scripts/migrate.ts",
    "bank:load": "node --conditions=@sudoku-killer/source --env-file-if-exists=.env scripts/load-bank.ts",
    "demo": "node --conditions=@sudoku-killer/source --env-file-if-exists=.env scripts/demo-match.ts"
  },
  "dependencies": {
    "@sudoku-killer/bank": "workspace:*",
    "@sudoku-killer/engine": "workspace:*",
    "@sudoku-killer/game": "workspace:*",
    "@sudoku-killer/protocol": "workspace:*",
    "@sudoku-killer/scoring": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11"
  }
}
