{
  "name": "@sudoku-killer/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build && node scripts/check-dist.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim:measure": "node --conditions=@sudoku-killer/source scripts/measure-sim-load.ts",
    "bots": "node --conditions=@sudoku-killer/source scripts/bots.ts",
    "e2e": "NODE_OPTIONS=--conditions=@sudoku-killer/source playwright test"
  },
  "dependencies": {
    "@sudoku-killer/engine": "workspace:*",
    "@sudoku-killer/game": "workspace:*",
    "@sudoku-killer/protocol": "workspace:*",
    "@sudoku-killer/scoring": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sudoku-killer/bank": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "ws": "8.22.0"
  }
}
